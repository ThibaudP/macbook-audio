[Unit]
Description=MacBook Audio settings and headphone routing
After=pipewire.service wireplumber.service macbook-apple-stack.service
Wants=macbook-apple-stack.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/macbook-apple-audio/stack-controller.py --daemon
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
